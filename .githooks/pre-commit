#!/bin/sh
# Strip GPS/location metadata from staged images before they enter history.
# Enable once per clone: git config core.hooksPath .githooks
files=$(git diff --cached --name-only --diff-filter=AM -z | xargs -0 -r printf '%s\n' | grep -iE '\.(jpe?g|png|webp|heic)$')
[ -z "$files" ] && exit 0
command -v exiftool >/dev/null || { echo "pre-commit: exiftool not found, refusing to commit images" >&2; exit 1; }
echo "$files" | while IFS= read -r f; do
  exiftool -q -overwrite_original -gps:all= -xmp:geotag= -location:all= "$f" && git add -- "$f"
done
